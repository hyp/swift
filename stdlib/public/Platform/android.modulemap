// The module map for the Android NDK.
module Android [system] [no_undeclared_includes] {
  // The features header pulls in cdefs which is
  // a textual header with C macros.
  textual header "features.h"

  // The C standard library.
  module C {
    link "m"

    // <assert.h>'s use of NDEBUG requires textual inclusion.
    textual header "assert.h"

    module complex {
      header "complex.h"
      export *
    }
    module ctype {
      header "ctype.h"
      export *
    }
    module errno {
      header "errno.h"
      export *
    }
    module fenv {
      header "fenv.h"
      export *
    }
    module inttypes {
      header "inttypes.h"
      export *
    }
    module limits {
      header "limits.h"
      export *
    }
    module locale {
      header "locale.h"
      export *
    }
    module malloc {
      header "malloc.h"
      export *
    }
    module math {
      header "math.h"
      export *
    }
    module pty {
      header "pty.h"
      export *
    }
    module setjmp {
      header "setjmp.h"
      export *
    }
    module signal {
      header "signal.h"
      export *
    }
    module stdatomic {
      header "stdatomic.h"
      header "bits/stdatomic.h"
      export *
    }
    module stdint {
      header "stdint.h"
      export *
    }
    module stdio {
      header "stdio.h"
      export *
    }
    module stdio_ext {
      header "stdio_ext.h"
      export *
    }
    module stdlib {
      header "stdlib.h"
      export *
    }
    module string {
      header "string.h"
      export *
    }
    module time {
      header "time.h"
      export *
    }
    module utmp {
      header "utmp.h"
      export *
    }
  }

  module alloca {
    header "alloca.h"
    export *
  }

  module ar {
    header "ar.h"
    export *
  }

  module cpio {
    header "cpio.h"
    export *
  }

  module dirent {
    header "dirent.h"
    export *
  }

  module dlfcn {
    header "dlfcn.h"
    export *
  }

  module err {
    header "err.h"
    export *
  }

  module errno {
    header "errno.h"
    export *
  }

  module execinfo {
    header "execinfo.h"
    export *
  }

  module fcntl {
    header "fcntl.h"
    export *
  }

  module fenv {
    header "fenv.h"
    export *
  }

  module fnmatch {
    header "fnmatch.h"
    export *
  }

  module fts {
    header "fts.h"
    export *
  }

  module ftw {
    header "ftw.h"
    export *
  }

  module getopt {
    header "getopt.h"
    export *
  }

  module glob {
    header "glob.h"
    export *
  }

  module grp {
    header "grp.h"
    export *
  }

  module iconv {
    header "iconv.h"
    export *
  }

  module ifaddrs {
    header "ifaddrs.h"
    export *
  }

  module jni {
    header "jni.h"
    export *
  }

  module langinfo {
    header "langinfo.h"
    export *
  }

  module libgen {
    header "libgen.h"
    export *
  }

  module link_ {
    header "link.h"
    export *
  }

  module mntent {
    header "mntent.h"
    export *
  }

  module netdb {
    header "netdb.h"
    export *
  }

  module nl_types {
    header "nl_types.h"
    export *
  }

  module paths {
    header "paths.h"
    export *
  }

  module poll {
    header "poll.h"
    export *
  }

  module pthread {
    header "pthread.h"
    export *
    link "pthread"
  }

  module pwd {
    header "pwd.h"
    export *
  }

  module regex {
    header "regex.h"
    export *
  }

  module resolv {
    header "resolv.h"
    export *
  }

  module sched {
    header "sched.h"
    export *
  }

  module search {
    header "search.h"
    export *
  }

  module semaphore {
    header "semaphore.h"
    export *
  }

  module spawn {
    header "spawn.h"
    export *
  }

  module strings {
    header "strings.h"
    export *
  }

  module syscall {
    header "syscall.h"
    export *
  }

  module sysexits {
    header "sysexits.h"
    export *
  }

  module syslog {
    header "syslog.h"
    export *
  }

  module tar {
    header "tar.h"
    export *
  }

  module termio {
    header "termio.h"
    export *
  }

  module termios {
    header "termios.h"
    export *
  }

  module threads {
    header "threads.h"
    header "bits/threads_inlines.h"
    export *
  }

  module uchar {
    header "uchar.h"
    export *
  }

  module uconfig_local {
    header "uconfig_local.h"
    export *
  }

  module ucontext {
    header "ucontext.h"
    export *
  }

  module unistd {
    header "unistd.h"
    export *
  }

  module utime {
    header "utime.h"
    export *
  }

  module utmp {
    header "utmp.h"
    export *
  }

  module utmpx {
    header "utmpx.h"
    export *
  }

  module wait {
    header "wait.h"
    export *
  }

  module wchar {
    header "wchar.h"
    export *
  }

  module xlocale {
    header "xlocale.h"
    export *
  }

  module android_log {
    header "android/log.h"
    export *
  }

  module bits {
    header "bits/in_addr.h"
    header "bits/ioctl.h"
    header "bits/ip_mreq_source.h"
    header "bits/ip_msfilter.h"
    header "bits/mbstate_t.h"
    header "bits/posix_limits.h"
    header "bits/sa_family_t.h"
    header "bits/signal_types.h"
    header "bits/timespec.h"
    export *
  }

  module sys {
    header "sys/endian.h"
    header "sys/file.h"
    header "sys/inotify.h"
    header "sys/ioctl.h"
    header "sys/ipc.h"
    header "sys/mman.h"
    header "sys/mount.h"
    header "sys/msg.h"
    header "sys/resource.h"
    header "sys/select.h"
    header "sys/sem.h"
    header "sys/sendfile.h"
    header "sys/shm.h"
    header "sys/socket.h"
    header "sys/stat.h"
    header "sys/statvfs.h"
    header "sys/time.h"
    header "sys/times.h"
    header "sys/types.h"
    header "sys/uio.h"
    header "sys/un.h"
    header "sys/user.h"
    header "sys/utsname.h"
    header "sys/wait.h"
    textual header "sys/cdefs.h"
    export *
  }
}

module zlib [system] {
  header "zconf.h"
  header "zlib.h"
  export *
  link "z"
}
