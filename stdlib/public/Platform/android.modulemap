// Use 'no_undeclared_includes' to avoid pulling in the libc++ headers. 
module android_sys_types [system] [no_undeclared_includes] {
  header "sys/types.h"
  // The 'sys/types.h' header has a circular include
  // with 'bits/pthread_types.h' and thus it must be in the same module.
  header "bits/pthread_types.h"
  export *
  use bionic_stdint
  use android_sys_cdefs
}
module android_sys_uio [system] {
  header "sys/uio.h"
  export *
}
module android_sys_un [system] {
  header "sys/un.h"
  export *
}
module android_sys_unistd [system] {
  header "sys/unistd.h"
  export *
}
// Use 'no_undeclared_includes' to avoid pulling in the libc++ headers. 
module android_sys_user [system] [no_undeclared_includes]  {
  header "sys/user.h"
  export *
  use bionic_stdint
  use android_sys_cdefs
}
module android_sys_utsname [system] {
  header "sys/utsname.h"
  export *
}
module android_sys_vfs [system] {
  header "sys/vfs.h"
  export *
}
module android_sys_wait [system] {
  header "sys/wait.h"
  export *
}

// Module for zlib headers.
module zlib [system] {
  header "zconf.h"
  header "zlib.h"
  export *
  link "z"
}
